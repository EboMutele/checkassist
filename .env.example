# Copy to .env and fill in. Never commit .env.
# On the live server (docs/DEPLOY.md), docker-compose.yml already sets APP_ENV=production, PROXY_COUNT=1
# and the storage paths; set BASE_URL=https://nerdaccess.store, SESSION_COOKIE_SECURE=1 and
# REDIRECT_TO_BASE_URL=1 here.

APP_ENV=development
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Public address of the site: email links, canonical links, the sitemap and Paystack's return address.
# Live: https://nerdaccess.store
BASE_URL=http://localhost:5000

# Storage (defaults to ./instance). Point these at a persistent disk in production.
# DATABASE_PATH=/data/nerdaccess.sqlite3
# UPLOAD_DIR=/data/uploads
MAX_UPLOAD_MB=25

# Promised minutes from upload to feedback. Drives the homepage promise, customers'
# expected-by time and the reviewers' due/overdue column. 0 hides the promise.
REVIEW_MINUTES=20

# Set to 1 when the site is served over HTTPS.
SESSION_COOKIE_SECURE=0

# Email (optional). Without RESEND_API_KEY or SMTP_HOST, notifications are in-app only.
# Recommended: Resend's API over HTTPS. DigitalOcean blocks the usual SMTP ports (25, 465, 587).
# Use a "Sending access" key limited to the mail.nerdaccess.store domain.
RESEND_API_KEY=
EMAIL_FROM=NerdAccess <notifications@mail.nerdaccess.store>
# Where replies to emails go. Empty: SUPPORT_EMAIL, or no Reply-To if that's empty too.
EMAIL_REPLY_TO=
# Or any SMTP service (used only when RESEND_API_KEY is empty). On DigitalOcean pick an alternative
# port your provider offers, such as 2587 or 2525.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=1
# Email reviewers about new uploads and customer replies (needed to hit REVIEW_MINUTES).
ADMIN_EMAIL_ALERTS=1

# Texts: customers get one when their feedback is sent. Leave SMS_PROVIDER empty to switch off.
# Country code (digits only) used when people type local numbers like 0712 345 678.
DEFAULT_COUNTRY_CODE=
# africastalking or twilio
SMS_PROVIDER=
# Africa's Talking (set AT_USERNAME=sandbox to test against the sandbox)
AT_USERNAME=
AT_API_KEY=
# Optional: a registered sender ID or shortcode.
AT_SENDER_ID=
# Twilio (use TWILIO_FROM or TWILIO_MESSAGING_SERVICE_SID)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_MESSAGING_SERVICE_SID=

# Payments (Paystack). Without PAYSTACK_SECRET_KEY, buying is off and admins add checks by hand.
# sk_test_... while testing, sk_live_... in production.
PAYSTACK_SECRET_KEY=
# Create the monthly plan once with: flask --app wsgi paystack-create-plan  (then paste the code here)
PAYSTACK_MONTHLY_PLAN_CODE=
# Optional: limit payment methods for packs, e.g. card,mobile_money,bank_transfer (monthly always uses card)
PAYSTACK_CHANNELS=
# Uploads spend checks (1 per 10,000 words). Set 0 only for a free trial period.
CHECKS_REQUIRED=1
# Checks given to every new account, e.g. 1 for a free first review.
SIGNUP_FREE_CHECKS=0

# Search engines. Indexing is on only when APP_ENV=production; set ALLOW_INDEXING=0 to keep a live site hidden,
# or 1 to index a non-production site (rarely what you want).
# ALLOW_INDEXING=
# From Google Search Console > Settings > Ownership verification > HTML tag (just the content="..." value).
GOOGLE_SITE_VERIFICATION=
# From Bing Webmaster Tools, if you don't import the site from Search Console.
BING_SITE_VERIFICATION=
# Shown in the footer and given to search engines as your contact address.
# For example support@nerdaccess.store (needs a mailbox; see docs/DEPLOY.md).
SUPPORT_EMAIL=
# 1 = send visitors on any other host name (www., yourapp.onrender.com) to BASE_URL with a permanent redirect.
REDIRECT_TO_BASE_URL=0

# The private Kenya link (KES prices, M-Pesa). Change it if the link spreads too far; leave empty to switch it off.
LOCAL_LINK_PATH=/local

# Number of reverse proxies in front of the app (1 with the Caddy setup in docker-compose.yml, which
# sets it for you). Leave 0 when visitors reach the app directly, or they could fake their IP address.
PROXY_COUNT=0
