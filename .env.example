# Copy to .env and fill in. Never commit .env.

APP_ENV=development
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Public address of the site, used in email links.
BASE_URL=http://localhost:5000

# Storage (defaults to ./instance). Point these at a persistent disk in production.
# DATABASE_PATH=/data/checkassist.sqlite3
# UPLOAD_DIR=/data/uploads
MAX_UPLOAD_MB=25

# Promised minutes from upload to feedback. Drives the homepage promise, customers'
# expected-by time and the reviewers' due/overdue column. 0 hides the promise.
REVIEW_MINUTES=20

# Set to 1 when the site is served over HTTPS.
SESSION_COOKIE_SECURE=0

# Email (optional). Without SMTP_HOST, notifications are in-app only.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=CheckAssist <no-reply@yourdomain.com>
SMTP_TLS=1
# Email reviewers about new uploads and customer replies (needed to hit REVIEW_MINUTES).
ADMIN_EMAIL_ALERTS=1

# Texts: customers get one when their feedback is sent. Leave SMS_PROVIDER empty to switch off.
# Country code (digits only) used when people type local numbers like 0712 345 678.
DEFAULT_COUNTRY_CODE=
SMS_PROVIDER=            # africastalking or twilio
# Africa's Talking (set AT_USERNAME=sandbox to test against the sandbox)
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=            # optional registered sender ID / shortcode
# Twilio (use TWILIO_FROM or TWILIO_MESSAGING_SERVICE_SID)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_MESSAGING_SERVICE_SID=
